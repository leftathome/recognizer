  "panels": [
    {
      "title": "Disc Rips by Type",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (media_type) (capture_disc_rip_total{namespace=\"$namespace\"})",
          "legendFormat": "{{media_type}}"
        }
      ]
    },
    {
      "title": "Rip Duration (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 10, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(capture_rip_duration_seconds_bucket{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(capture_rip_duration_seconds_bucket{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(capture_rip_duration_seconds_bucket{namespace=\"$namespace\"}[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Scan Sessions",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "sum(capture_scan_session_total{namespace=\"$namespace\"})",
          "legendFormat": "Total Sessions"
        }
      ]
    },
    {
      "title": "Pages per Session (avg)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [
        {
          "expr": "avg(capture_scan_pages_per_session{namespace=\"$namespace\"})",
          "legendFormat": "Avg Pages"
        }
      ]
    },
    {
      "title": "Notification Success Rate",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4},
      "targets": [
        {
          "expr": "sum(rate(capture_notification_success_total{namespace=\"$namespace\"}[5m])) / (sum(rate(capture_notification_success_total{namespace=\"$namespace\"}[5m])) + sum(rate(capture_notification_failure_total{namespace=\"$namespace\"}[5m])))",
          "legendFormat": "Success Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.9},
              {"color": "green", "value": 0.99}
            ]
          }
        }
      }
    },
    {
      "title": "Dead-Letter Backlog",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "capture_notification_dead_letter_total{namespace=\"$namespace\"}",
          "legendFormat": "Dead Letters"
        }
      ]
    }
